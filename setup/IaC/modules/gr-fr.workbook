      "content": {
        "version": "KqlItem/1.0",
        "query": "GuardrailsCompliance_CL\n| where column_ifexists(\"ReportTime_s\", \"\") == '{RunTime}'\n| summarize by column_ifexists(\"ControlName_s\", \"\")\n| count \n| extend Title=\"Nombre total d’articles\"\n| project-rename ['Nombre'] = ['Count'], ['Titre'] = ['Title']",
        "size": 4,
        "timeContext": {
          "durationMs": 2592000000
        },
