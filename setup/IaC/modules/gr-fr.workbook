    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "gr_non_mfa_users('{RunTime}','__MFA_GRACE_PERIOD__','fr-CA')\n| extend UserType = case(UserType == \"Member\", \"Membre\", UserType == \"Guest\", \"Invité\", UserType == \"N/A\", \"S. O.\", UserType), CreatedTime = iff(CreatedTime == \"N/A\", \"S. O.\", CreatedTime), LastSignIn = iff(LastSignIn == \"N/A\", \"S. O.\", LastSignIn)\n| project-rename ['Nom d’affichage'] = ['DisplayName'], ['Nom d’utilisateur principal'] = ['UserPrincipalName'], ['Type d’utilisateur'] = ['UserType'], ['Date de création'] = ['CreatedTime'], ['Dernière connexion'] = ['LastSignIn'], ['Commentaires'] = ['Comments']",
        "size": 0,
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
