      "content": {
        "version": "KqlItem/1.0",
        "query": "GR2ExternalUsers_CL \n| where column_ifexists(\"ReportTime_s\", \"\") == \"{RunTime}\"\n| project \n    DisplayName_s = column_ifexists(\"DisplayName_s\", \"\"),\n    Mail_s = column_ifexists(\"Mail_s\", \"\"),\n    Subscription_s = column_ifexists(\"Subscription_s\", \"\"),\n    Role_s = column_ifexists(\"Role_s\", \"\"),\n    PrivilegedRole_s = column_ifexists(\"PrivilegedRole_s\", \"\"),\n    Comments_s = column_ifexists(\"Comments_s\", \"\")\n| project-rename ['Nom d’affichage'] = ['DisplayName_s'], ['Courriel'] = ['Mail_s'], ['Abonnement'] = ['Subscription_s'], ['Rôle'] = ['Role_s'], ['Rôle privilégié'] = ['PrivilegedRole_s'], ['Commentaires'] = ['Comments_s']",
        "size": 0,
