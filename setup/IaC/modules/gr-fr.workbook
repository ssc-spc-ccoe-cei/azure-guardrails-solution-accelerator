    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "// Original query for table\n//let lic = GRITSGControls_CL | summarize max(TimeGenerated);\ngr_data(\"GUARDRAIL 1\",\"{RunTime}\", \"{RequiredYesNo}\" )\n// Translate headers only; recorded item names and audit comments stay unchanged.\n| project-rename ['Nom de l’article'] = ['Item Name'], ['Commentaires'] = ['Comments'], ['Statut'] = ['Status'], ['Contrôle ITSG'] = ['ITSG Control'], ['Mesures correctives'] = ['Remediation'], ['Profil'] = ['Profile']",
        "size": 0,
        "title": "MESURE 1",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Mesures correctives",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "Url"
              }
            },
            {
              "columnMatch": "Link",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "Url"
              }
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "gr1"
      },
      "name": "Query - 1"
    },
    {
      "type": 1,
      "content": {
        "json": "<h3>Sommaire des contrôles pour la mesure de protection 1</h3>",
        "size": 1
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "gr1"
      },
      "name": "Title - summary of Guardrail 1",
      "styleSettings": {
        "showBorder": false
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "gr_pie(\"GUARDRAIL 1\",\"{RunTime}\",  \"True\" )\n// Translate chart labels after the shared function computes the compliance counts.\n| extend Status = case(Status == \"Compliant Items\", \"Articles conformes\", Status == \"Non-compliant Items\", \"Articles non conformes\", Status == \"Not Applicable Items\", \"Articles sans objet\", Status), Title = \"Articles par état de conformité\"\n| project-rename ['Statut'] = ['Status'], ['Titre'] = ['Title']",
        "size": 4,
        "title": "Mesure 1 — conformité des contrôles obligatoires",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart",
        "chartSettings": {
          "showLegend": true,
          "seriesLabelSettings": [
            {
              "seriesName": "Articles non conformes",
              "color": "redBright"
            },
            {
              "seriesName": "Articles conformes",
              "color": "green"
            },
            {
              "seriesName": "Articles sans objet",
              "color": "gray"
            }
          ]
        }
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "gr1"
      },
      "name": "Gr1 Mandatory Compliance Summary",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "gr_pie(\"GUARDRAIL 1\",\"{RunTime}\",  \"False\" )\n| extend Status = case(Status == \"Compliant Items\", \"Articles conformes\", Status == \"Non-compliant Items\", \"Articles non conformes\", Status == \"Not Applicable Items\", \"Articles sans objet\", Status), Title = \"Articles par état de conformité\"\n| project-rename ['Statut'] = ['Status'], ['Titre'] = ['Title']",
        "size": 4,
        "title": "Mesure 1 — conformité des contrôles recommandés",
